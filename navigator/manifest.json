{
  "manifest_version": 3,
  "name": "AirMotion Navigator",
  "version": "1.0.0",
  "description": "AI-powered gesture browser control",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "ws://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
